# Defaults for ESP32-S3 with external PSRAM and 16 MB flash.
# Run `idf.py menuconfig` if your board uses quad PSRAM or different pins.

CONFIG_IDF_TARGET="esp32s3"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 16 MB flash (the partition table ends at 0x420000).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The board is reachable through a CH340 USB-UART bridge on UART0, so use
# UART0 for both logs and keyboard input. Switch these two lines back to
# USB Serial/JTAG if you connect the native USB port instead.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_DCT3_KBD_BACKEND_UART=y
CONFIG_DCT3_KBD_UART=0
CONFIG_DCT3_KBD_BAUD=115200
CONFIG_DCT3_KBD_UART_TX=-1
CONFIG_DCT3_KBD_UART_RX=-1

# Passive PC Speaker / buzzer (LEDC PWM).
CONFIG_DCT3_SPEAKER_GPIO=5

# PSRAM: the 4 MiB flat DCT3 address space lives here. N16R8-class boards use
# octal PSRAM; switch to CONFIG_SPIRAM_MODE_QUAD for quad-PSRAM parts.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384

# Custom partition table (factory app + raw "fw" partition).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
